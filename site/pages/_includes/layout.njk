{% set base = '../' if section else '' %}
{% set neighbors = collections.docs | pager(section, page.url) %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%231e9a6d'/><path d='M5 23h22' stroke='%23fff' stroke-width='3' stroke-linecap='round'/><rect x='7' y='8' width='7' height='9' rx='2' fill='%23fff2cc'/><rect x='18' y='8' width='7' height='9' rx='2' fill='%23fff2cc'/><path d='M10.5 17v6M21.5 17v6' stroke='%23fff' stroke-width='2'/></svg>">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · BusDiagram</title>
<link rel="stylesheet" href="{{ base }}assets/docs.css">
<script src="{{ base }}assets/bus-diagram.js"></script>
{% if scripts %}{% for script in scripts.split(',') %}<script src="{{ base }}{{ script | trim }}"></script>{% endfor %}{% endif %}
<script defer src="{{ base }}assets/search-index.js"></script>
<script defer src="{{ base }}assets/docs.js" data-base="{{ base }}"></script>
</head>
<body class="{{ section or 'home' }}">
<header class="site">
  <a class="brand" href="{{ base }}index.html">Bus<span>Diagram</span></a>
  <nav>
    <a href="{{ base }}guide/installation.html"{% if section == 'guide' %} class="cur"{% endif %}>Guide</a>
    <a href="{{ base }}examples/index.html"{% if section == 'examples' %} class="cur"{% endif %}>Examples</a>
    <a href="{{ base }}reference/index.html"{% if section == 'reference' %} class="cur"{% endif %}>Reference</a>
    <a href="{{ base }}designer/index.html">Designer</a>
  </nav>
  <div class="search"><input type="search" placeholder="Search…" aria-label="Search documentation"><ul class="results" hidden></ul></div>
  <a class="repo" href="{{ repository }}">GitHub</a>
  <a class="dl" href="{{ base }}assets/bus-diagram.js" download>Download</a>
</header>
<div class="layout{% if not section %} wide{% endif %}">
{% if section %}<aside class="side">
{% for group in collections.docs | sectionGroups(section) %}
  {% if group.name %}<h4>{{ group.name }}</h4>{% endif %}
  <ul>{% for item in group.pages %}<li{% if item.url == page.url %} class="cur"{% endif %}><a href="{{ base }}{{ item.url | stripLeadingSlash }}">{{ item.data.title }}</a></li>{% endfor %}</ul>
{% endfor %}
</aside>{% endif %}
<main>
{% if section %}<p class="crumb">{{ section | sectionTitle }}</p>{% endif %}
{{ content | safe }}
{% if neighbors.previous or neighbors.next %}<nav class="pager">
{% if neighbors.previous %}<a href="{{ base }}{{ neighbors.previous.url | stripLeadingSlash }}">← {{ neighbors.previous.data.title }}</a>{% else %}<span></span>{% endif %}
{% if neighbors.next %}<a href="{{ base }}{{ neighbors.next.url | stripLeadingSlash }}">{{ neighbors.next.data.title }} →</a>{% endif %}
</nav>{% endif %}
</main>
{% if headings and headings.length > 2 %}<aside class="toc"><h4>On this page</h4><ul>{% for heading in headings %}{% if heading.depth == 2 %}<li><a href="#{{ heading.id }}">{{ heading.text }}</a></li>{% endif %}{% endfor %}</ul></aside>{% endif %}
</div>
<footer class="site">BusDiagram {{ version }} · offline documentation · <a href="{{ base }}designer/index.html">Designer</a> · <a href="{{ repository }}">Source code (GitHub)</a> · <a href="{{ repository }}/blob/main/CHANGELOG.md">Changes</a> · <a href="{{ base }}THIRD_PARTY_NOTICES.txt">Third-party notices</a></footer>
</body>
</html>
