      "address": "1.1"
    },
    {
      "address": "1.2"
    },
    {
      "address": "2.1",
      "extension": {
        "address": "2.1.64",
        "mode": "repeater",
        "switchable": true
      }
    },
    {
      "address": "2.2",
      "name": "no device"
    }
  ],
  "topology": {
