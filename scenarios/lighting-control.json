{
  "title": "Control multiple outputs",
  "description": "A four-key push-button and a four-output switching actuator each use one individual address. Key 1 (on) and Key 2 (off) control L1 and L2; Key 3 (on) and Key 4 (off) control L1 through L4. One telegram can operate several outputs.",
  "lines": [
    {
      "address": "1.1",
      "name": "Example line"
    }
  ],
  "groupAddresses": [
    {
      "address": "1/1/1",
      "name": "L1–L2 lighting",
      "dpt": "1.001"
    },
    {
      "address": "1/1/2",
      "name": "L1–L4 lighting",
      "dpt": "1.001"
    }
  ],
  "devices": [
    {
      "id": "pushButton",
      "address": "1.1.1",
      "name": "Push-button",
      "kind": "pushButton",
      "description": "A four-key push-button: one device, one individual address, and one group object per key.",
      "objects": [
        {
          "id": "key1",
          "name": "Key 1",
          "ga": "1/1/1"
        },
        {
          "id": "key2",
          "name": "Key 2",
          "ga": "1/1/1"
        },
        {
          "id": "key3",
          "name": "Key 3",
          "ga": "1/1/2"
        },
        {
          "id": "key4",
          "name": "Key 4",
          "ga": "1/1/2"
        }
      ],
      "buttons": [
        {
          "label": "Key 1",
          "press": {
            "object": "key1",
            "value": 1
          }
        },
        {
          "label": "Key 2",
          "press": {
            "object": "key2",
            "value": 0
          }
        },
        {
          "label": "Key 3",
          "press": {
            "object": "key3",
            "value": 1
          }
        },
        {
          "label": "Key 4",
          "press": {
            "object": "key4",
            "value": 0
          }
        }
      ]
    },
    {
      "id": "switchActuator",
      "address": "1.1.2",
      "name": "Four-output switching actuator",
      "kind": "switchActuator",
      "description": "One four-channel switching actuator. Channels 1 and 2 listen to both group addresses; channels 3 and 4 listen only to 1/1/2.",
      "channels": [
        {
          "id": "s1",
          "label": "L1"
        },
        {
          "id": "s2",
          "label": "L2"
        },
        {
          "id": "s3",
          "label": "L3"
        },
        {
          "id": "s4",
          "label": "L4"
        }
      ],
      "objects": [
        {
          "id": "c1",
          "name": "Channel 1",
          "ga": ["1/1/1", "1/1/2"],
          "role": "switch",
          "channel": "s1"
        },
        {
          "id": "c2",
          "name": "Channel 2",
          "ga": ["1/1/1", "1/1/2"],
          "role": "switch",
          "channel": "s2"
        },
        {
          "id": "c3",
          "name": "Channel 3",
          "ga": "1/1/2",
          "role": "switch",
          "channel": "s3"
        },
        {
          "id": "c4",
          "name": "Channel 4",
          "ga": "1/1/2",
          "role": "switch",
          "channel": "s4"
        }
      ]
    }
  ]
}
